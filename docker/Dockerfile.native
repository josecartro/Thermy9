FROM rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1
RUN apt-get update && apt-get install -y --no-install-recommends clang lld llvm nsis python3-venv nodejs npm && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/build-tools && /opt/build-tools/bin/pip install --no-cache-dir cargo-xwin==0.23.1
ENV PATH="/opt/build-tools/bin:${PATH}"
RUN rustup target add x86_64-pc-windows-msvc
WORKDIR /work/native
